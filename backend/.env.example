# Application Settings
PROJECT_NAME="AI-Powered Enterprise Document Intelligence & Knowledge Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage & Upload Settings
STORAGE_DIR="data/uploads"
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=[".pdf"]

# Structure-Aware Chunking Settings
CHUNK_TARGET_SIZE_TOKENS=450
CHUNK_MAX_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNK_TOKENIZER_ENCODING="cl100k_base"

# Dense Embeddings Settings
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="enterprise_documents"

# BM25 Sparse Lexical Search Configuration
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_PATH="data/bm25_index.pkl"
BM25_AUTO_PERSIST=True

# Hybrid Retrieval & Rank Fusion Settings
HYBRID_DENSE_TOP_K=50
HYBRID_SPARSE_TOP_K=50
HYBRID_FINAL_TOP_K=10
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.6
HYBRID_SPARSE_WEIGHT=0.4
HYBRID_FUSION_STRATEGY="rrf"
HYBRID_RETRIEVAL_TIMEOUT_SECONDS=5.0
HYBRID_ENABLE_QUERY_AWARE_TUNING=True

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enterprise_doc_intelligence
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_doc_intelligence

# Phase 8 LLM Provider & RAG Settings
LLM_PROVIDER="mock"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=10.0

# Phase 10 JWT & Security Configuration
JWT_SECRET_KEY="generate-a-long-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER="enterprise-document-platform"
JWT_AUDIENCE="enterprise-document-platform-api"
